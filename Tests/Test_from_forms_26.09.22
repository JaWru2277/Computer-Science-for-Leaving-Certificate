score = int(input("Please Enter the house score: "))

if (score <= 10):
     print("Energy Rating = F")
elif (score <=20):
    print("Energy Rating = E")
elif (score <= 30):
    print("Energy Rating = D")
elif (score <= 40):
    print("Energy Rating = C")
elif (score <= 70):
    print("Energy Rating = B")
elif (score <= 100):
    print("Energy Rating = A")
else:
    print("Enter valid range")
